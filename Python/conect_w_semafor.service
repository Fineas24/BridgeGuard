[Unit]
Description=BridgeGuard Conectare Pico W + Temperatura (test_conect_w_pico.py)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/html/proiect/Python
EnvironmentFile=/var/www/html/proiect/Python/.env
ExecStart=/usr/bin/python3 /var/www/html/proiect/Python/test_conect_w_pico.py
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
